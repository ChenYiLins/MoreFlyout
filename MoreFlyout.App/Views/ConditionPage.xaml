<Page
    x:Class="MoreFlyout.App.Views.ConditionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:MoreFlyout.App.Helpers"
    xmlns:local="using:MoreFlyout.App.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <ScrollView>
        <StackPanel Style="{StaticResource PageBaseStackPanelStyle}">

            <!--  Game mode  -->
            <controls:SettingsCard
                Description="{helpers:ResourceString Name=GameModeDescription}"
                Header="{helpers:ResourceString Name=GameMode}"
                HeaderIcon="{ui:FontIcon Glyph=&#xE7FC;}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.GameModeEnabled, Mode=TwoWay}" />
            </controls:SettingsCard>

            <!--  Energy saver  -->
            <controls:SettingsCard
                Description="{helpers:ResourceString Name=EnergySaverDescription}"
                Header="{helpers:ResourceString Name=EnergySaver}"
                HeaderIcon="{ui:FontIcon Glyph=&#xF1E8;}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.EnergySaverEnabled, Mode=TwoWay}" />
            </controls:SettingsCard>

        </StackPanel>
    </ScrollView>

</Page>
